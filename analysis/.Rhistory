# Function to read multiple CSV files from a directory
read_multiple_csvs <- function(directory_path, pattern = "*.csv") {
file_paths <- list.files(directory_path, pattern = pattern, full.names = TRUE)
if (length(file_paths) == 0) {
warning(paste("No CSV files found in", directory_path))
return(data.frame())
}
# Read and combine all CSV files
data_list <- map(file_paths, ~ {
tryCatch({
read_csv(.x, show_col_types = FALSE)
}, error = function(e) {
warning(paste("Error reading file", .x, ":", e$message))
return(data.frame())
})
})
# Remove empty data frames and combine
data_list <- data_list[map_lgl(data_list, ~ nrow(.x) > 0)]
if (length(data_list) > 0) {
return(bind_rows(data_list))
} else {
return(data.frame())
}
}
# Function to load data for multiple years
load_yearly_data <- function(data_type, years, sample_size = NULL) {
base_path <- "data/FishingVessels/"
all_data <- list()
for (year in years) {
if (data_type == "fleet_daily") {
dir_path <- paste0(base_path, "fleet-daily-csvs-100-v3-", year, "/")
} else if (data_type == "fleet_monthly") {
dir_path <- paste0(base_path, "fleet-monthly-csvs-10-v3-", year, "/")
} else if (data_type == "mmsi_daily") {
dir_path <- paste0(base_path, "mmsi-daily-csvs-10-v3-", year, "/")
} else {
stop("Invalid data_type. Use 'fleet_daily', 'fleet_monthly', or 'mmsi_daily'")
}
if (dir.exists(dir_path)) {
year_data <- read_multiple_csvs(dir_path)
if (nrow(year_data) > 0) {
year_data$year <- year
all_data[[as.character(year)]] <- year_data
cat("Loaded", data_type, "for year", year, ":", nrow(year_data), "records\n")
}
} else {
cat("Directory not found:", dir_path, "\n")
}
}
if (length(all_data) > 0) {
combined_data <- bind_rows(all_data)
# Sample data if requested (for memory management)
if (!is.null(sample_size) && nrow(combined_data) > sample_size) {
combined_data <- combined_data %>% sample_n(sample_size)
cat("Sampled", sample_size, "records from", data_type, "\n")
}
return(combined_data)
} else {
return(data.frame())
}
}
# Years of interest
years <- 2012:2014
# Years of interest
years <- 2020:2024
# Load sample data for testing (use sample_size to limit memory usage)
fleet_daily_sample <- load_yearly_data("fleet_daily", years, sample_size = 10000)
